<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/launcherRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/ivWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_launcher_demo" />

    <LinearLayout
        android:id="@+id/statusPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:background="@drawable/launcher_status_pill"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <View
            android:id="@+id/viewStatusDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/launcher_status_disconnected" />

        <TextView
            android:id="@+id/tvLauncherStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:text="Đang chờ..."
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/liquidGlassClock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:gravity="end"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <TextClock
            android:id="@+id/tvClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format24Hour="HH:mm"
            android:format12Hour="HH:mm"
            android:shadowColor="#66000000"
            android:shadowRadius="4"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSolarDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="Thứ Ba, 24/11/2026"
            android:textColor="#F5F5F5"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvLunarDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="Âm lịch: 15/10"
            android:textColor="#FFD54F"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/launcherDock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@android:color/transparent"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="0dp">

        <LinearLayout
            android:id="@+id/dockMaps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/LauncherDockItem"
            android:contentDescription="Maps">
            <ImageView android:id="@+id/ivDockMaps" style="@style/LauncherDockIcon" android:src="@drawable/ic_vec_maps" />
            <TextView android:id="@+id/tvDockLabel0" style="@style/LauncherDockLabel" android:text="Maps" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dockTikTok"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/LauncherDockItem"
            android:contentDescription="TikTok">
            <ImageView android:id="@+id/ivDockTikTok" style="@style/LauncherDockIcon" android:src="@drawable/ic_vec_tiktok" />
            <TextView android:id="@+id/tvDockLabel1" style="@style/LauncherDockLabel" android:text="TikTok" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dockYouTube"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/LauncherDockItem"
            android:contentDescription="YouTube">
            <ImageView android:id="@+id/ivDockYouTube" style="@style/LauncherDockIcon" android:src="@drawable/ic_vec_youtube" />
            <TextView android:id="@+id/tvDockLabel2" style="@style/LauncherDockLabel" android:text="YouTube" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dockApps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/LauncherDockItem"
            android:contentDescription="Ứng dụng">
            <ImageView android:id="@+id/ivDockApps" style="@style/LauncherDockIcon" android:src="@drawable/ic_vec_apps" />
            <TextView style="@style/LauncherDockLabel" android:text="Ứng dụng" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
